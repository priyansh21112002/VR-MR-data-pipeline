      targetMode: 2
      fixedPosition: {x: 0, y: 0, z: 0}
      sceneObjectName: 
  - taskNumber: 7
    description: Move the Yellow Box from Shipping to a Level 1 shelf in Storage B
    primaryObject: Box_6
    targetObject: Target_6
    subtasks:
    - type: navigate
      description: Walk to the Yellow Box near the Shipping dock (left side)
      targetMode: 1
