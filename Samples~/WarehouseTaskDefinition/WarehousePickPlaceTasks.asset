      sceneObjectName: 
    - type: pick
      description: Pick up the Orange Box from the floor pallet
      targetMode: 1
      fixedPosition: {x: 0, y: 0, z: 0}
      sceneObjectName: 
    - type: place
      description: Carry the Orange Box across the warehouse to Shipping and place it on the target pallet
      targetMode: 2
      fixedPosition: {x: 0, y: 0, z: 0}
      sceneObjectName: 
  - taskNumber: 5
    description: Move the Purple Box from the Equipment zone to a Level 1 shelf in Storage A
    primaryObject: Box_4
    targetObject: Target_4
    subtasks:
    - type: navigate
      description: Walk to the Purple Box in the Equipment zone (back of warehouse)
      targetMode: 1
      fixedPosition: {x: 0, y: 0, z: 0}
      sceneObjectName: 
    - type: pick
      description: Pick up the Purple Box from the floor pallet
      targetMode: 1
      fixedPosition: {x: 0, y: 0, z: 0}
      sceneObjectName: 
    - type: place
      description: Carry the Purple Box to Storage A and place it on the elevated Level 1 shelf target in Aisle A
      targetMode: 2
      fixedPosition: {x: 0, y: 0, z: 0}
      sceneObjectName: 
  - taskNumber: 6
    description: Transfer the Cyan Box from Staging to the Order Picking zone
