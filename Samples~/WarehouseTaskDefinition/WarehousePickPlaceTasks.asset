  tasks:
  - taskNumber: 1
    description: Retrieve the Red Box from Storage A aisle and deliver it to the Receiving bay
    primaryObject: Box_0
    targetObject: Target_0
    subtasks:
    - type: navigate
      description: Walk into Storage A aisle (between Shelf rows at x=8 and x=14)
      targetMode: 1
      fixedPosition: {x: 0, y: 0, z: 0}
      sceneObjectName: 
    - type: pick
      description: Pick up the Red Box from the floor pallet in Aisle A
      targetMode: 1
      fixedPosition: {x: 0, y: 0, z: 0}
      sceneObjectName: 
    - type: place
      description: Carry the Red Box south and place it on the target pallet in the Receiving bay
      targetMode: 2
      fixedPosition: {x: 0, y: 0, z: 0}
      sceneObjectName: 
  - taskNumber: 2
    description: Move the Blue Box from Receiving to the Level 1 shelf in Storage B
    primaryObject: Box_1
    targetObject: Target_1
    subtasks:
    - type: navigate
      description: Walk to the Blue Box in the Receiving bay (right side)
      targetMode: 1
      fixedPosition: {x: 0, y: 0, z: 0}
      sceneObjectName: 
    - type: pick
      description: Pick up the Blue Box from the floor pallet
      targetMode: 1
      fixedPosition: {x: 0, y: 0, z: 0}
      sceneObjectName: 
    - type: place
      description: Carry the Blue Box into Storage B and place it on the elevated Level 1 shelf target in Aisle B
      targetMode: 2
      fixedPosition: {x: 0, y: 0, z: 0}
      sceneObjectName: 
  - taskNumber: 3
    description: Transfer the Green Box from the Main Aisle to the Staging area
    primaryObject: Box_2
    targetObject: Target_2
    subtasks:
    - type: navigate
      description: Walk to the Green Box sitting in the Main Aisle
      targetMode: 1
      fixedPosition: {x: 0, y: 0, z: 0}
      sceneObjectName: 
    - type: pick
      description: Pick up the Green Box
      targetMode: 1
      fixedPosition: {x: 0, y: 0, z: 0}
      sceneObjectName: 
    - type: place
      description: Carry the Green Box east and place it on the target in the Staging area
      targetMode: 2
      fixedPosition: {x: 0, y: 0, z: 0}
      sceneObjectName: 
  - taskNumber: 4
    description: Retrieve the Orange Box from deep in Storage B and deliver it to Shipping
    primaryObject: Box_3
    targetObject: Target_3
